# Copy to .env. Local unauthenticated deployment is loopback only.
PA_PORT=8765
PA_DATA_DIR=./data
# Git executable; leave empty to use PATH.
PA_GIT_EXECUTABLE=git
# Streamable HTTP MCP endpoint. No URL credentials, query or fragment.
PA_MCP_URL=
# Comma-separated names explicitly approved as read-only by the operator.
PA_MCP_READ_TOOLS=
# Optional semantic adapter. Must match an allowed discovered tool.
PA_MCP_PROFILE_TOOL=
PA_MCP_PROFILE_ARGUMENT=profile_id
# JSON object of fixed arguments; no secrets.
PA_MCP_PROFILE_ARGS={}
# Optional dotted identity path inside structuredContent, e.g. profile.id.
PA_MCP_PROFILE_IDENTITY_PATH=
# Prefer entering token through Settings. Environment token is imported encrypted on startup.
PA_MCP_TOKEN=
# Optional local full documentation file. No automatic remote link loading.
PA_DOCUMENT_PATH=
# Optional OpenAI-compatible chat-completions endpoint, HTTPS (HTTP loopback without key).
PA_MODEL_URL=
PA_MODEL_NAME=
PA_MODEL_CONTEXT_TOKENS=16384
PA_MODEL_TOKEN=
# Optional HTTPS external read-only executor implementing docs/executor.md.
PA_EXECUTOR_URL=
PA_EXECUTOR_TOKEN=
# Required on non-Windows: Fernet key supplied outside this file via environment.
# Windows uses user-bound DPAPI instead.
PA_MASTER_KEY=

