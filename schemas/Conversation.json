{
  "$defs": {
    "Options": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Metrics",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Paths",
          "type": "array"
        },
        "hotspots": {
          "default": 3,
          "maximum": 5,
          "minimum": 0,
          "title": "Hotspots",
          "type": "integer"
        },
        "active_seconds": {
          "default": 180,
          "maximum": 600,
          "minimum": 10,
          "title": "Active Seconds",
          "type": "integer"
        },
        "executor": {
          "default": "analysis",
          "enum": [
            "analysis",
            "external"
          ],
          "title": "Executor",
          "type": "string"
        },
        "required_ranges": {
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "maxItems": 8,
          "title": "Required Ranges",
          "type": "array"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "revision": {
          "default": 0,
          "title": "Revision",
          "type": "integer"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "ref": {
          "default": "HEAD",
          "title": "Ref",
          "type": "string"
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        },
        "credential_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        }
      },
      "title": "Settings",
      "type": "object"
    },
    "SourceRange": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ],
      "title": "SourceRange",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "default": "",
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "repository": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "ref": {
          "default": "HEAD",
          "maxLength": 256,
          "title": "Ref",
          "type": "string"
        },
        "profile_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Open Questions",
          "type": "array"
        },
        "spec_version": {
          "default": 0,
          "title": "Spec Version",
          "type": "integer"
        }
      },
      "title": "TaskSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskSpec"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": [
    "id",
    "title",
    "task",
    "settings"
  ],
  "title": "Conversation",
  "type": "object"
}
